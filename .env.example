# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id_here

# Optional: Bags.fm API Key (for enhanced data)
BAGS_API_KEY=your_bags_api_key_here

# Alert Thresholds
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H=10000
MIN_HOLDERS=50
MAX_TOP_HOLDER_PERCENT=20
MIN_SCORE=60

# Scanning intervals (in seconds)
SCAN_INTERVAL_NEW_PAIRS=60
SCAN_INTERVAL_TRENDING=300
SCAN_INTERVAL_PATTERN_CHECK=120

# Database
DATABASE_PATH=./data/tokens.db

# Logging
LOG_LEVEL=INFO
